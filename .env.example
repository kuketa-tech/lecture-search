# Скопируйте в .env и поменяйте нужное. Все параметры — в backend/config.py.

# LLM для формулировок конспекта и ответов в чате (OpenAI-совместимый API).
# Ollama:   LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_MODEL=qwen2.5:7b
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1 LLM_MODEL=deepseek-chat LLM_API_KEY=sk-...
LLM_BACKEND=auto
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# Локальная модель в процессе (если сервер LLM недоступен): python -m tools.download_models --local-llm
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Если huggingface.co недоступен — зеркало для скачивания моделей
# HF_ENDPOINT=https://hf-mirror.com

# Работа без интернета (после python -m tools.download_models)
OFFLINE=0
# Без видеокарты: DEVICE=cpu ASR_MODEL=small EMBED_MODEL=intfloat/multilingual-e5-small RERANK_MODEL=
DEVICE=auto
